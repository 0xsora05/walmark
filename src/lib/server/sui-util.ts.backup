// Pure helpers for the direct Sui + Walrus backend. No imports on purpose, so they are unit-testable on their own.

export class SuiBackendError extends Error {
  // Declared by hand (no constructor parameter property) so Node can run this file directly in the unit tests.
  status: number;
  constructor(message: string, status = 502) {
    super(message);
    this.status = status;
  }
}


/** Turn SDK errors into something a person can act on. */
export function explainWriteError(err: unknown): SuiBackendError {
  if (err instanceof SuiBackendError) return err;
  const msg = err instanceof Error ? err.message : String(err);
  if (/insufficient|not enough.*(gas|coin|balance)|no valid gas|GasBalanceTooLow/i.test(msg)) {
    return new SuiBackendError('The server wallet is out of SUI (gas) or WAL (storage). Fund it, then retry. See Settings for the wallet address.', 402);
  }
  if (/WAL/i.test(msg) && /(balance|coin|enough)/i.test(msg)) {
    return new SuiBackendError('The server wallet has no WAL to pay for storage. Swap some SUI for WAL, then retry.', 402);
  }
  if (/401|403|api key|unauthorized/i.test(msg)) return new SuiBackendError('The Sui RPC rejected the API key (check TATUM_API_KEY).', 502);
  if (/429|rate/i.test(msg)) return new SuiBackendError('Rate limited by the Sui RPC or the upload relay. Try again shortly.', 429);
  return new SuiBackendError(`Walrus write failed: ${msg.slice(0, 240)}`);
}


const MIST = 1_000_000_000n;
export function formatCoin(raw: string | bigint): string {
  const v = typeof raw === 'bigint' ? raw : BigInt(raw || '0');
  const whole = v / MIST;
  const frac = (v % MIST).toString().padStart(9, '0').slice(0, 4).replace(/0+$/, '');
  return frac ? `${whole}.${frac}` : `${whole}`;
}


export interface BlobObjectInfo {
  exists: boolean;
  isWalrusBlob: boolean;
  blobId?: string;
  size?: number;
  certified?: boolean;
  startEpoch?: number;
  endEpoch?: number;
  deletable?: boolean;
  owner?: string;
}

/** Pulls the fields we care about out of a `sui_getObject` response (showContent + showOwner + showType). */
export function parseBlobObject(raw: unknown, blobIdFromInt: (v: string) => string): BlobObjectInfo {
  const r = raw as {
    data?: {
      type?: string;
      owner?: { AddressOwner?: string } | string;
      content?: { fields?: Record<string, unknown> };
    };
    error?: unknown;
  } | null;
  const data = r?.data;
  if (!data) return { exists: false, isWalrusBlob: false };
  const fields = (data.content?.fields ?? {}) as Record<string, unknown>;
  const isBlob = /::blob::Blob$/.test(data.type ?? '');
  const storageRaw = fields.storage as { fields?: Record<string, unknown> } | undefined;
  const storage = (storageRaw?.fields ?? storageRaw ?? {}) as Record<string, unknown>;
  const num = (v: unknown) => (v === undefined || v === null ? undefined : Number(v));
  let blobId: string | undefined;
  try {
    if (typeof fields.blob_id === 'string') blobId = blobIdFromInt(fields.blob_id);
  } catch {
    blobId = undefined;
  }
  return {
    exists: true,
    isWalrusBlob: isBlob,
    blobId,
    size: num(fields.size),
    certified: fields.certified_epoch !== undefined && fields.certified_epoch !== null,
    startEpoch: num(storage.start_epoch),
    endEpoch: num(storage.end_epoch),
    deletable: typeof fields.deletable === 'boolean' ? fields.deletable : undefined,
    owner: typeof data.owner === 'object' ? data.owner?.AddressOwner : undefined,
  };
}



export interface AccountObjectInfo {
  exists: boolean;
  type?: string;
  version?: string;
  owner?: string;
  delegateKeys?: number;
}

/**
 * Summarises a MemWal account object read with `sui_getObject` (showType + showOwner + showContent).
 * The exact Move struct is MemWal's, so this only reports what any object has, plus a count of
 * delegate keys when the struct exposes them as a list.
 */
export function parseAccountObject(raw: unknown): AccountObjectInfo {
  const data = (raw as { data?: Record<string, unknown> } | null)?.data;
  if (!data) return { exists: false };
  const owner = data.owner as Record<string, unknown> | string | undefined;
  let ownerLabel: string | undefined;
  if (typeof owner === 'string') ownerLabel = owner;
  else if (owner && typeof owner === 'object') {
    if (typeof owner.AddressOwner === 'string') ownerLabel = owner.AddressOwner;
    else if ('Shared' in owner) ownerLabel = 'shared object';
    else if (typeof owner.ObjectOwner === 'string') ownerLabel = `object ${owner.ObjectOwner}`;
  }
  const fields = ((data.content as { fields?: Record<string, unknown> } | undefined)?.fields ?? {}) as Record<string, unknown>;
  let delegateKeys: number | undefined;
  for (const [k, v] of Object.entries(fields)) {
    if (/delegate/i.test(k)) {
      if (Array.isArray(v)) delegateKeys = v.length;
      else if (v && typeof v === 'object') {
        const inner = (v as { fields?: { contents?: unknown[] } }).fields?.contents;
        if (Array.isArray(inner)) delegateKeys = inner.length;
      }
    }
  }
  const type = typeof data.type === 'string' ? data.type : undefined;
  return {
    exists: true,
    type: type ? type.replace(/^0x[0-9a-fA-F]+::/, '') : undefined,
    version: data.version === undefined ? undefined : String(data.version),
    owner: ownerLabel,
    delegateKeys,
  };
}
