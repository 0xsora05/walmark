# ---- Easiest: run `npm run setup:mainnet` (writes .env.local for you), then `npm run doctor` to check it. ----

# Which Walrus network is used: mainnet | testnet (default testnet).
WALRUS_NETWORK=mainnet
# "walrus" talks to the real network, "mock" keeps blobs in a temp dir (tests/demo only).
WALRUS_MODE=walrus

# A secret you invent (16+ random characters). Both server-key backends below stay off without it;
# you paste it once in Settings. It stops strangers spending your wallet / MemWal key if the app is public.
WALMARK_ACCESS_TOKEN=

# ---- Total Recall needs: MemWal (below) + TATUM_API_KEY. The wallet backend is optional. ----

# ---- Tatum (required by Total Recall): the Sui RPC ----
# Free key: https://dashboard.tatum.io . Sui calls go to https://sui-<network>.gateway.tatum.io with it.
TATUM_API_KEY=

# ---- Optional: direct Sui + Walrus (wallet signs the writes) ----
# A DEDICATED wallet (suiprivkey1... or 64 hex) holding a little SUI for gas and some WAL for storage.
# Never your main wallet: the server signs with it.
SUI_PRIVATE_KEY=
# Optional overrides
# SUI_RPC_URL=https://sui-mainnet.gateway.tatum.io
# WALRUS_UPLOAD_RELAY_URL=https://upload-relay.mainnet.walrus.space   # "none" = write to storage nodes directly (slow)
# WALMARK_MAX_WRITES_PER_DAY=300

# ---- Main backend: Walrus Memory (MemWal, managed relayer) ----
# Create the delegate key + account ID at https://memory.walrus.xyz
MEMWAL_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_NAMESPACE=walmark

# ---- Backend 3: plain Walrus blobs ----
# Testnet works out of the box. Mainnet has NO public publisher: set one only if you run your own.
# WALRUS_PUBLISHER_URL=https://your-publisher.example.com
# WALRUS_PUBLISHER_TOKEN=
# WALRUS_AGGREGATOR_URL=https://aggregator.walrus-mainnet.walrus.space

# For testnet instead: WALRUS_NETWORK=testnet (Tatum gives a testnet gateway too), MEMWAL_SERVER_URL=https://relayer.dev.memwal.ai
# WALMARK_MOCK_DIR=/tmp/walmark-mock
